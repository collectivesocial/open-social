# Devnet environment — local development against atproto-devnet.
# This file is checked into git. All values are throwaway devnet defaults.
#
# Usage:
#   npm run devnet:up        # start PDS, PLC, postgres, etc.
#   npm run dev:devnet       # start the app
#   npm run test:devnet      # run smoke tests

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/opensocial
PDS_URL=http://localhost:2583
PLC_URL=http://localhost:2582
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_SECRET=4d1b93e86724cdc05fcbc1008ec177501d7ab8487f9f760216b920ebddc1a432
OPENSOCIAL_SERVICE_DID=did:web:localhost%3A3001

# Force OAuth client loopback mode for devnet (no PRIVATE_KEYS needed).
# Root .env sets SERVICE_URL for production-style confidential-client config;
# without this override that value leaks in here (dotenv.config() only fills
# vars not already set) and createOAuthClient() asserts on missing PRIVATE_KEYS.
SERVICE_URL=
