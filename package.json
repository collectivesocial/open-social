{
  "name": "open-social",
  "version": "1.0.0",
  "description": "Community management infrastructure for ATProto apps",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc --project tsconfig.migrations.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:setup": "psql $DATABASE_URL -f scripts/schema.sql",
    "db:reset": "./scripts/reset-db.sh",
    "clear-data": "tsx scripts/clearData.ts",
    "migrate:admins": "tsx scripts/migrateAdmins.ts",
    "migrate:up": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "migrate:status": "tsx scripts/migrate.ts status",
    "devnet:up": "./scripts/start-test-env.sh",
    "devnet:down": "./scripts/stop-test-env.sh",
    "dev:devnet": "bash -c 'set -a && source .env.devnet && exec tsx watch src/index.ts'",
    "seed:devnet": "bash -c 'set -a && source .env.devnet && exec tsx scripts/seed-devnet-community.ts'",
    "seed:devenv": "bash -c 'set -a && source .env.devnet && exec tsx scripts/seed-devenv-community.ts'",
    "migrate:devenv": "bash -c 'set -a && source .env.devnet && exec tsx scripts/migrate.ts \"$@\"' --",
    "provision:spaces": "bash -c 'set -a && source .env.devnet && exec tsx scripts/provision-community-spaces.ts \"$@\"' --",
    "demo:membership": "bash -c 'set -a && source .env.devnet && exec tsx scripts/demo-membership.ts \"$@\"' --",
    "test:devnet": "bash -c 'set -a && source .env.devnet && exec vitest run --config vitest.config.devnet.ts'",
    "test:integration": "vitest run test/integration/",
    "prepare": "husky"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@atproto/api": "^0.13.35",
    "@atproto/identity": "^0.4.12",
    "@atproto/oauth-client-node": "^0.3.13",
    "@atproto/xrpc-server": "^0.10.20",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "envalid": "^8.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "iron-session": "^8.0.4",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.28.8",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "sanitize-html": "^2.17.0",
    "uuid": "^13.0.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.11",
    "@types/pg": "^8.16.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "husky": "^9.1.7",
    "kysely-migration-cli": "^0.4.2",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": "prettier --write"
  }
}
